diff --git a/library/lib/platforms/switch/switch_platform.cpp b/library/lib/platforms/switch/switch_platform.cpp
index 8525abb..36d7aba 100644
--- a/library/lib/platforms/switch/switch_platform.cpp
+++ b/library/lib/platforms/switch/switch_platform.cpp
@@ -183,13 +183,17 @@ void SwitchPlatform::setBacklightBrightness(float brightness)
 {
     if (brightness < 0) brightness = 0.0f;
     if (brightness > 1) brightness = 1.0f;
+    if (R_FAILED(lblInitialize())) return;
     lblSetCurrentBrightnessSetting(brightness);
+    lblExit();
 }
 
 float SwitchPlatform::getBacklightBrightness()
 {
     float brightness = 0.0f;
+    if (R_FAILED(lblInitialize())) return brightness;
     lblGetCurrentBrightnessSetting(&brightness);
+    lblExit();
     return brightness;
 }
 
